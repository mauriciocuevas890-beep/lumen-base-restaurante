# Copia este archivo como ".env" y llena tus valores de Supabase.
# Si NO configuras esto, la app funciona igual guardando en el navegador (localStorage).

# En tu proyecto de Supabase: Settings -> API
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_LLAVE_ANON_PUBLICA

# Identificador del negocio (para separar datos si manejas varios)
VITE_NEGOCIO_ID=lumen-base-demo
